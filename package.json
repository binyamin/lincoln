{
	"name": "@binyamin/lincoln",
	"type": "module",
	"version": "1.1.0",
	"description": "Test for broken links. CLI + API.",
	"main": "index.js",
	"bin": {
		"lincoln": "cli.js"
	},
	"engines": {
		"node": ">=22"
	},
	"files": [
		"lib/",
		"*.ts"
	],
	"scripts": {
		"test": "mocha --recursive test/",
		"test:unit": "mocha --recursive test/ -f=#unit",
		"types": "npx typescript index.js --declaration --allowJs --emitDeclarationOnly"
	},
	"keywords": [
		"link",
		"broken",
		"dead",
		"checker",
		"url"
	],
	"author": "Binyamin Aron Green (https://binyam.in/)",
	"license": "MIT",
	"devDependencies": {
		"chai": "^6.2.2",
		"mocha": "^12.0.0",
		"serve-handler": "^6.1.7"
	},
	"dependencies": {
		"@types/node": "^22.20.1",
		"jsdom": "^30.0.1",
		"ora": "^9.4.1",
		"xml2js": "^0.6.2"
	},
	"directories": {
		"test": "test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/binyamin/lincoln.git"
	},
	"bugs": {
		"url": "https://github.com/binyamin/lincoln/issues"
	},
	"homepage": "https://github.com/binyamin/lincoln#readme"
}
